# Asset-level rules for Owlbear extension chunk loading on shared hosts.
# This file is copied to dist/assets/.htaccess by Vite from public/assets/.htaccess.

<IfModule mod_headers.c>
    # Allow both apex and www Owlbear origins, and future subdomains.
    SetEnvIfNoCase Origin "^https://([a-z0-9-]+\.)*owlbear\.rodeo$" OBR_ORIGIN=$0
    Header always set Access-Control-Allow-Origin "%{OBR_ORIGIN}e" env=OBR_ORIGIN
    Header always set Vary "Origin"
</IfModule>

<IfModule mod_mime.c>
    AddType application/wasm .wasm
</IfModule>

# Prevent stale browser caches of chunk responses (including transient 403s).
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
    FileETag None
    Header unset ETag
    Header unset Last-Modified
    Header unset Pragma
    Header unset Cache-Control
    Header unset Expires
    Header always set Pragma "no-cache"
    Header always set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header always set Expires "Thu, 1 Jan 1970 00:00:00 GMT"
</IfModule>

# Do not rewrite asset URLs to WordPress index.php.
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>
